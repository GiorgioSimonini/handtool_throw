<?xml version="1.0"?>
<!-- Simulated ball throwing: gazebo + backstepping controller + the throwing nodes.

     The robot base stands base_z over the floor, as in the lab (configs/ball_throwing.txt).
     The objects come from sim_objects, generate them first with the same base height:
       rosrun handtool_throw generate_sim_objects.py   (options n, seed, x, y, base-height)
     then run the choice 7 of the testing node. ball_throw_plugin spawns the balls in their
     row, attaches the one under the tube tip at the suction and throws it with its measured
     energy at the blow. rviz shows the targets, the balls and their landing points. -->
<launch>
	<arg name="base_z"      default="0.935" doc="[m] robot base over the floor, same as generate_sim_objects.py --base-height" />
	<arg name="sim_objects" default="$(find handtool_throw)/configs/sim_throw_objects.yaml" />
	<arg name="headless"    default="false" />
	<arg name="rviz"        default="true" />

	<!-- gazebo, robot with the tube and backstepping controller, as panda_controllers_sim.launch -->
	<rosparam command="load" file="$(find panda_controllers)/config/panda_controllers.yaml" />
	<include file="$(find panda_controllers)/launch/gazebo/panda.launch">
		<arg name="world"            value="$(find handtool_throw)/worlds/ball_throw.world" />
		<arg name="z"                value="$(arg base_z)" />
		<arg name="headless"         value="$(arg headless)" />
		<arg name="rviz"             value="$(arg rviz)" />
		<arg name="rviz_config"      value="$(find handtool_throw)/rviz/ball_throw.rviz" />
		<arg name="controller"       value="backstepping_controller" />
		<arg name="description_file" value="$(find handtool_throw)/urdf/panda_with_tube.urdf.xacro" />
		<arg name="xacro_args"       value="tube:=true" />
	</include>

	<!-- testing node and throwing service, with the parameters of the real robot -->
	<include file="$(find handtool_throw)/launch/handtool_throw.launch" />
	<!-- loaded after throw_objects.yaml: replaces only the object list -->
	<rosparam command="load" file="$(arg sim_objects)" />
</launch>
